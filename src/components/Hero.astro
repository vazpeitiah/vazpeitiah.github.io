---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import SocialLink from "./SocialLink.astro";

const highlights = [
  {
    title: t("hero.highlightExperience.title"),
    description: t("hero.highlightExperience.description"),
  },
  {
    title: t("hero.highlightStack.title"),
    description: t("hero.highlightStack.description"),
  },
];
---

<section
  class="relative isolate overflow-hidden"
  id="hero"
  aria-labelledby="home"
>
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-20 bg-gradient-to-br from-base-200/80 via-base-100 to-base-200/60"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 opacity-60"
    style="background-image: radial-gradient(60% 60% at 20% 20%, rgba(59, 130, 246, 0.18), transparent 65%), radial-gradient(50% 50% at 80% 30%, rgba(236, 72, 153, 0.18), transparent 70%), radial-gradient(35% 35% at 30% 80%, rgba(14, 165, 233, 0.18), transparent 65%);"
  >
  </div>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-48 left-1/2 h-[28rem] w-[28rem] -translate-x-1/2 rounded-full bg-primary/20 blur-3xl"
  ></span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-44 right-[-12rem] h-[32rem] w-[32rem] rounded-full bg-secondary/15 blur-3xl motion-safe:animate-blob"
  ></span>
  <div
    class="relative mx-auto flex min-h-[calc(100vh-6rem)] w-full max-w-6xl flex-col gap-16 px-4 pb-24 pt-32 lg:flex-row lg:items-center lg:gap-20 lg:px-0"
  >
    <div class="relative flex-1 space-y-10 text-center lg:text-left">
      <div
        class="inline-flex items-center justify-center gap-3 self-center rounded-full border border-primary/20 bg-primary/10 px-6 py-2 text-xs font-semibold uppercase tracking-[0.35em] text-primary/80 shadow-sm shadow-primary/10 backdrop-blur lg:self-start"
      >
        <span class="size-2 rounded-full bg-primary/70"></span>
        {t("hero.tagline")}
      </div>
      <h1
        class="text-4xl font-black leading-tight text-balance text-base-content sm:text-5xl lg:text-6xl"
        id="home"
      >
        <span
          class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent"
        >
          {t("hero.welcome")}
        </span>
      </h1>
      <p
        class="mx-auto max-w-xl text-lg leading-relaxed text-base-content/80 lg:mx-0"
      >
        {t("hero.description")}
      </p>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
        <a
          class="group inline-flex items-center justify-center gap-3 rounded-full bg-gradient-to-r from-primary via-secondary to-accent px-8 py-3 text-sm font-semibold text-primary-content shadow-xl shadow-primary/40 transition-transform duration-300 hover:-translate-y-1"
          href="/cv.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{t("hero.cv")}</span>
          <span
            aria-hidden="true"
            class="inline-flex size-8 items-center justify-center rounded-full bg-primary/25 text-lg transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>
        </a>
        <a
          class="inline-flex items-center justify-center gap-3 rounded-full border border-base-content/10 bg-base-100/70 px-8 py-3 text-sm font-semibold text-base-content shadow-sm backdrop-blur transition-all duration-300 hover:border-primary/40 hover:text-primary"
          href="#proyects"
        >
          <span>{t("hero.secondaryCta")}</span>
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          highlights.map((item) => (
            <div class="rounded-2xl border border-base-300/40 bg-base-100/75 p-5 text-left shadow-lg shadow-primary/5 backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-primary/20">
              <p class="text-[0.65rem] font-semibold uppercase tracking-[0.4em] text-primary/70">
                {item.title}
              </p>
              <p class="mt-3 text-sm font-semibold text-base-content">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
      <ul
        class="flex flex-wrap items-center justify-center gap-3 sm:justify-start"
      >
        <SocialLink href="https://github.com/vazpeitiah" icon="github" />
        <SocialLink
          href="https://www.linkedin.com/in/vazpeitiah/"
          icon="linkedin"
        />
        <SocialLink href="https://wa.me/527721432826" icon="whatsapp" />
      </ul>
    </div>
    <div class="relative flex-1">
      <div
        class="pointer-events-none absolute -left-12 top-1/4 hidden w-48 -translate-y-6 rounded-3xl border border-primary/30 bg-base-100/70 p-4 text-left text-xs font-semibold text-base-content shadow-lg shadow-primary/10 backdrop-blur lg:block"
      >
        <p class="text-[0.65rem] uppercase tracking-[0.4em] text-primary/70">
          {t("hero.availability")}
        </p>
        <p class="mt-2 text-sm text-base-content/80">{t("hero.location")}</p>
      </div>
      <div
        class="pointer-events-none absolute -right-10 top-10 hidden h-36 w-36 rounded-full bg-gradient-to-br from-secondary/20 via-primary/20 to-accent/20 blur-3xl motion-safe:animate-blob lg:block"
      >
      </div>
      <div
        class="relative mx-auto max-w-xs overflow-hidden rounded-[2.75rem] border border-base-300/50 bg-base-100/70 p-6 shadow-2xl shadow-primary/10 backdrop-blur-lg sm:max-w-sm"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-8 -top-16 h-32 rounded-full bg-gradient-to-r from-primary/30 via-secondary/25 to-accent/30 blur-3xl"
        ></span>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -inset-1 rounded-[3rem] border border-white/10"
        ></span>
        <div class="relative flex items-center justify-center">
          <img
            src="/programming.svg"
            alt={t("hero.imageAlt")}
            class="w-full max-w-xs drop-shadow-2xl motion-safe:animate-float-soft"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="mt-6 space-y-2 text-center">
          <p
            class="text-xs font-semibold uppercase tracking-[0.45em] text-primary/60"
          >
            {t("hero.subtitle")}
          </p>
          <p class="text-sm text-base-content/70">
            {t("hero.highlightStack.description")}
          </p>
        </div>
      </div>
      <div
        class="pointer-events-none absolute -bottom-12 left-1/2 hidden w-48 -translate-x-1/2 rounded-3xl border border-accent/30 bg-base-100/70 p-4 text-center text-xs font-semibold text-base-content shadow-lg shadow-accent/10 backdrop-blur lg:block"
      >
        {t("hero.highlightExperience.description")}
      </div>
    </div>
  </div>
</section>
