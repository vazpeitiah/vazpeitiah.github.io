---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import SocialLink from "./SocialLink.astro";
---

<section
  class="relative isolate overflow-hidden bg-base-200/70"
  id="hero"
  aria-labelledby="home"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 -right-16 h-72 w-72 rounded-full bg-primary/25 blur-3xl motion-safe:animate-pulse-glow"
  ></span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-40 -left-24 h-96 w-96 rounded-full bg-secondary/20 blur-3xl motion-safe:animate-pulse-glow"
  ></span>
  <div class="hero min-h-screen px-4 py-24 lg:px-0">
    <div
      class="hero-content w-full max-w-6xl flex-col gap-16 rounded-3xl border border-base-300/40 bg-base-100/80 p-8 shadow-2xl backdrop-blur-xl transition-transform duration-500 lg:flex-row-reverse lg:gap-20 lg:p-16"
    >
      <div class="relative flex-1">
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -top-16 left-1/2 h-24 w-24 -translate-x-1/2 rounded-full bg-gradient-to-br from-primary/30 via-secondary/20 to-primary/10 blur-2xl"
        ></span>
        <img
          src="/programming.svg"
          alt={t("hero.imageAlt")}
          class="mx-auto max-w-lg drop-shadow-2xl motion-safe:animate-float"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="flex flex-1 flex-col gap-6 text-center lg:text-left">
        <p
          class="inline-flex items-center justify-center gap-3 self-center rounded-full border border-primary/30 bg-primary/10 px-5 py-2 text-xs font-semibold uppercase tracking-[0.35em] text-primary/80 shadow-sm lg:self-start"
        >
          <span class="size-2 rounded-full bg-primary/70"></span>
          {t("hero.subtitle")}
        </p>
        <h1
          class="text-4xl font-bold leading-tight text-balance sm:text-5xl"
          id="home"
        >
          <span
            class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent"
          >
            {t("hero.welcome")}
          </span>
        </h1>
        <p class="text-lg leading-relaxed text-base-content/80">
          {t("hero.description")}
        </p>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            class="btn btn-primary btn-wide shadow-lg shadow-primary/40 transition-transform duration-300 hover:-translate-y-1 hover:shadow-primary/60"
            href="/cv.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t("hero.cv")}
          </a>
          <ul class="flex flex-wrap items-center justify-center gap-2 sm:justify-start">
            <SocialLink href="https://github.com/vazpeitiah" icon="github" />
            <SocialLink
              href="https://www.linkedin.com/in/vazpeitiah/"
              icon="linkedin"
            />
            <SocialLink href="https://wa.me/527721432826" icon="whatsapp" />
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
