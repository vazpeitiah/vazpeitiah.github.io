---
import clsx from "clsx";
import { Icon } from "astro-icon/components";

import type { TimeLineItem } from "../utils/types";

interface Props {
  items: TimeLineItem[];
}

const { items } = Astro.props;
---

<ul
  class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical"
>
  {
    items.map((item, index) => (
      <li
        class="group relative motion-safe:animate-fade-in-up"
        style={`animation-delay: ${index * 120}ms`}
      >
        <div class="timeline-middle text-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-5 w-5"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
              clip-rule="evenodd"
            />
          </svg>
        </div>
        <div
          class={clsx("timeline-start", {
            ["md:text-end"]: index % 2 === 0,
            ["timeline-end"]: index % 2 !== 0,
          })}
        >
          <div
            class="relative rounded-2xl border border-base-300/40 bg-base-100/80 p-6 shadow-lg shadow-primary/5 transition-all duration-300 ease-out group-hover:-translate-y-1 group-hover:shadow-primary/20"
          >
            <time class="font-mono text-sm uppercase tracking-[0.3em] text-base-content/70">
              {item.date}
            </time>
            <div
              class={clsx("mt-3 flex items-center gap-2 text-lg font-black text-base-content", {
                ["md:justify-end"]: index % 2 === 0,
              })}
            >
              {item.title}
              {item.link && (
                <a
                  href={item.link}
                  class="btn btn-ghost btn-xs gap-1 border border-primary/30 bg-primary/10 text-primary/80 transition-colors duration-300 hover:bg-primary hover:text-primary-content"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="link" />
                </a>
              )}
            </div>
            <div class="mt-2 text-base font-semibold text-primary/80">
              {item.subtitle}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-base-content/80">
              {item.description}
            </p>
          </div>
        </div>
        <hr class="border-primary/20" />
      </li>
    ))
  }
</ul>
