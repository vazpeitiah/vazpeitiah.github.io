---
import clsx from "clsx";
import { Icon } from "astro-icon/components";

import type { TimeLineItem } from "../utils/types";

interface Props {
  items: TimeLineItem[];
}

const { items } = Astro.props;
---

<ul class="relative flex flex-col gap-12">
  <span
    aria-hidden="true"
    class="pointer-events-none absolute left-4 top-0 h-full w-px bg-gradient-to-b from-primary/40 via-secondary/30 to-accent/40"
  ></span>
  {
    items.map((item, index) => (
      <li
        class="group relative pl-12 motion-safe:animate-fade-in-up"
        style={`animation-delay: ${index * 120}ms`}
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute left-0 top-6 flex size-10 items-center justify-center rounded-full border border-base-300/60 bg-base-100/80 text-primary shadow-lg shadow-primary/10 transition-transform duration-300 group-hover:-translate-y-1"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="size-5"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
              clip-rule="evenodd"
            />
          </svg>
        </span>
        <article class="relative rounded-3xl border border-base-300/50 bg-base-100/75 p-6 shadow-xl shadow-primary/10 backdrop-blur transition-all duration-300 ease-out hover:-translate-y-1.5 hover:border-primary/50 hover:shadow-primary/20">
          <time class="font-mono text-xs uppercase tracking-[0.35em] text-base-content/60">
            {item.date}
          </time>
          <div
            class={clsx(
              "mt-3 flex flex-col gap-2 text-base-content sm:flex-row sm:items-center sm:justify-between",
              {
                ["sm:flex-row-reverse"]: index % 2 === 0,
              }
            )}
          >
            <h3
              class={clsx("text-lg font-black", {
                ["sm:text-right"]: index % 2 === 0,
              })}
            >
              {item.title}
            </h3>
            {item.link && (
              <a
                href={item.link}
                class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-base-100/80 px-3 py-1 text-xs font-semibold uppercase tracking-[0.3em] text-primary/80 transition-all duration-300 hover:border-primary hover:bg-primary hover:text-primary-content"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="link" class="size-4" />
              </a>
            )}
          </div>
          <p
            class={clsx("mt-2 text-sm font-semibold text-primary/70", {
              ["sm:text-right"]: index % 2 === 0,
            })}
          >
            {item.subtitle}
          </p>
          <p
            class={clsx("mt-3 text-sm leading-relaxed text-base-content/80", {
              ["sm:text-right"]: index % 2 === 0,
            })}
          >
            {item.description}
          </p>
        </article>
      </li>
    ))
  }
</ul>
