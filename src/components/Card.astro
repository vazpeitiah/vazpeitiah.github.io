---
import { Icon } from "astro-icon/components";
import type { Project } from "../utils/types";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props extends Project {}

const {
  title,
  description,
  codeUrl,
  demoUrl,
  image,
  showCode,
  showDemo,
  tags,
} = Astro.props;
---

<div
  class="group card card-compact relative overflow-hidden border border-base-300/40 bg-base-100/80 shadow-xl transition-all duration-500 ease-out hover:-translate-y-2 hover:shadow-glow"
>
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-primary/70 via-secondary/60 to-accent/70"
  ></span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100"
    style="background: radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.12), transparent 55%);"
  ></span>
  <figure class="relative flex h-48 items-center justify-center bg-gradient-to-br from-primary/10 via-transparent to-secondary/10">
    <img
      src={image}
      alt={
        lang === "en"
          ? `${title} project illustration`
          : `Ilustración del proyecto ${title}`
      }
      class="h-32 w-32 object-contain drop-shadow-lg motion-safe:animate-float-slow"
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div class="card-body gap-4">
    <h2 class="card-title text-balance">
      <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">
        {title}
      </span>
    </h2>
    <div class="flex flex-wrap gap-2">
      {
        tags?.map((tag) => (
          <span class="badge badge-outline border-primary/30 bg-primary/10 text-xs font-semibold text-primary/80">
            {tag}
          </span>
        ))
      }
    </div>
    <p class="text-sm leading-relaxed text-base-content/80">{description}</p>
    <div class="card-actions justify-end gap-2">
      {
        showCode && (
          <a
            class="btn btn-outline btn-primary btn-sm gap-2 transition-transform duration-300 hover:-translate-y-0.5"
            href={codeUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="code" />
            {t("projects.card.code")}
          </a>
        )
      }
      {
        showDemo && (
          <a
            class="btn btn-primary btn-sm gap-2 shadow-primary/40 transition-transform duration-300 hover:-translate-y-0.5 hover:shadow-lg"
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="network" />
            {t("projects.card.live")}
          </a>
        )
      }
    </div>
  </div>
</div>
