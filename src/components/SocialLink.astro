---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  icon: string;
}

const { href, icon } = Astro.props;
const labelMap: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
  whatsapp: "WhatsApp",
};
const accessibleLabel = labelMap[icon] ?? icon;
---

<li>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="btn btn-circle border border-transparent bg-base-100/70 text-base-content shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:bg-primary/10 hover:text-primary"
    aria-label={accessibleLabel}
    title={accessibleLabel}
  >
    <Icon name={icon} class="size-6" />
  </a>
</li>
