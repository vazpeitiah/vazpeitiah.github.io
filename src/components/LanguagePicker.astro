---
import clsx from "clsx";
import { languages } from "../i18n/ui";
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const segments = Astro.url.pathname.split("/").filter(Boolean);
const baseSegments = [...segments];
if (baseSegments[0] === lang) {
  baseSegments.shift();
}
let basePath = `/${baseSegments.join("/")}`;
if (!basePath || basePath === "//") {
  basePath = "/";
}
if (basePath !== "/" && basePath.endsWith("/")) {
  basePath = basePath.slice(0, -1);
}
const isBlogPost = baseSegments[0] === "blog" && baseSegments.length > 1;
---

<div class="join">
  {
    Object.entries(languages).map(([key, value]) => (
      <a
        class={clsx("btn join-item btn-sm uppercase font-semibold", {
          ["btn-secondary"]: lang === key,
        })}
        href={translatePath(key === lang ? basePath : isBlogPost ? "/blog" : basePath, key)}
      >
        {value.slice(0, 2)}
      </a>
    ))
  }
</div>
