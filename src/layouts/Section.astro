---
import clsx from "clsx";

interface Props {
  title: string;
  htmlId: string;
  className?: string;
}

const { title, className, htmlId } = Astro.props;
---

<section
  id={htmlId}
  class={clsx(
    "relative isolate flex min-h-screen w-full justify-center overflow-hidden bg-base-100 px-4 py-16 lg:px-0 lg:py-24",
    className
  )}
  aria-labelledby={`${htmlId}-title`}
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-12 top-12 -z-10 h-56 rounded-full bg-gradient-to-r from-primary/15 via-secondary/10 to-primary/15 blur-3xl"
  ></span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 left-8 -z-10 h-72 w-72 rounded-full bg-secondary/15 blur-3xl motion-safe:animate-pulse-glow"
  ></span>
  <div class="relative z-10 flex w-full max-w-5xl flex-col items-center gap-12">
    <div class="flex w-full flex-col items-center gap-4 text-center">
      <div class="relative inline-flex items-center justify-center">
        <span
          aria-hidden="true"
          class="absolute inset-x-4 top-1/2 -z-10 h-px -translate-y-1/2 bg-gradient-to-r from-transparent via-primary/40 to-transparent"
        ></span>
        <h1
          id={`${htmlId}-title`}
          class="px-6 text-4xl font-bold text-balance text-base-content sm:text-5xl"
        >
          <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">
            {title}
          </span>
        </h1>
      </div>
    </div>
    <div class="flex w-full flex-col gap-10">
      <slot />
    </div>
  </div>
</section>
