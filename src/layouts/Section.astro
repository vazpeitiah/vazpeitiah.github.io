---
import clsx from "clsx";

interface Props {
  title: string;
  htmlId: string;
  className?: string;
}

const { title, className, htmlId } = Astro.props;
---

<section
  id={htmlId}
  class={clsx(
    "relative isolate overflow-hidden px-4 py-24 sm:py-28",
    className
  )}
  aria-labelledby={`${htmlId}-title`}
>
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-20 bg-gradient-to-b from-base-200/80 via-base-100 to-base-200/70"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 opacity-40"
    style="background-image: radial-gradient(45% 45% at 15% 20%, rgba(59, 130, 246, 0.22), transparent 70%), radial-gradient(45% 45% at 80% 10%, rgba(236, 72, 153, 0.2), transparent 70%), radial-gradient(30% 30% at 80% 85%, rgba(56, 189, 248, 0.18), transparent 75%);"
  ></div>
  <div class="relative mx-auto w-full max-w-6xl">
    <div class="absolute inset-x-8 -top-10 -z-10 h-40 rounded-full bg-gradient-to-r from-primary/20 via-secondary/20 to-accent/20 blur-3xl"></div>
    <div class="group relative overflow-hidden rounded-[2.75rem] border border-base-300/50 bg-base-100/75 p-10 shadow-2xl shadow-primary/10 backdrop-blur">
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(120deg,rgba(255,255,255,0.12),rgba(255,255,255,0))] opacity-0 transition-opacity duration-700 group-hover:opacity-100"
      ></span>
      <div class="relative flex w-full flex-col items-center gap-12">
        <div class="flex w-full flex-col items-center gap-6 text-center">
          <div class="relative inline-flex flex-col items-center gap-4">
            <span
              aria-hidden="true"
              class="pointer-events-none inline-flex h-12 items-center justify-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-6 text-xs font-semibold uppercase tracking-[0.4em] text-primary/80"
            >
              {title}
            </span>
            <h1
              id={`${htmlId}-title`}
              class="text-3xl font-black text-balance text-base-content sm:text-4xl"
            >
              <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">
                {title}
              </span>
            </h1>
          </div>
        </div>
        <div class="flex w-full flex-col gap-10">
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>
