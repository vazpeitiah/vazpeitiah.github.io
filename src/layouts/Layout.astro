---
import "@fontsource-variable/nunito-sans";
import { GoogleAnalytics } from "astro-google-analytics";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import { defaultLanguage, languages } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const localeMap: Record<string, string> = {
  en: "en_US",
  es: "es_MX",
};
const providedTitle = title?.trim();
const providedDescription = description?.trim();
const providedImage = image?.trim();
const defaultTitle = t("seo.title");
const pageTitle = providedTitle ? `${providedTitle} | ${defaultTitle}` : defaultTitle;
const metaDescription = providedDescription ?? t("seo.description");
const metaKeywords = t("seo.keywords");
const author = t("seo.author");
const siteUrl = Astro.site
  ? new URL(Astro.site)
  : new URL("https://vladimirah.com");
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const baseSegments = [...pathSegments];
if (baseSegments[0] === lang) {
  baseSegments.shift();
}
let basePath = `/${baseSegments.join("/")}`;
if (!basePath || basePath === "//") {
  basePath = "/";
}
if (basePath !== "/" && basePath.endsWith("/")) {
  basePath = basePath.slice(0, -1);
}
const imageURL = new URL(providedImage ?? "/programming.svg", siteUrl).toString();
const ogLocale = localeMap[lang] ?? lang;
const alternateLocales = Object.entries(localeMap)
  .filter(([code]) => code !== lang)
  .map(([, value]) => value);
const languageAlternates = Object.keys(languages).map((code) => ({
  code,
  href: new URL(translatePath(basePath, code), siteUrl).toString(),
}));
const defaultAlternateHref = new URL(
  translatePath(basePath, defaultLanguage),
  siteUrl
).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: author,
  alternateName: "Vladimir A.",
  jobTitle: t("hero.subtitle"),
  description: metaDescription,
  url: canonicalURL.toString(),
  image: imageURL,
  sameAs: [
    "https://github.com/vazpeitiah",
    "https://www.linkedin.com/in/vazpeitiah/",
    "https://wa.me/527721432826",
  ],
  knowsAbout: ["React", "Flutter", "Frontend Development", "TypeScript"],
  address: {
    "@type": "PostalAddress",
    addressCountry: "MX",
  },
} as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content={author} />
    <meta name="application-name" content={defaultTitle} />
    <meta name="language" content={lang} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="favicon/favicon.ico" type="image/x-icon" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.toString()} />
    {
      languageAlternates.map(({ code, href }) => (
        <link rel="alternate" hreflang={code} href={href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultAlternateHref} />
    <meta property="og:locale" content={ogLocale} />
    {alternateLocales.map((value) => (
      <meta property="og:locale:alternate" content={value} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:site_name" content={defaultTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <meta name="twitter:url" content={canonicalURL.toString()} />
    <title>{pageTitle}</title>
    <script is:inline>
      import { DARK_THEME, LIGHT_THEME } from "../utils/config";

      if (typeof window !== "undefined") {
        function toggleTheme() {
          const currentTheme = localStorage.getItem("theme") || DARK_THEME;
          const newTheme =
            currentTheme === LIGHT_THEME ? DARK_THEME : LIGHT_THEME;
          const themeController = document.getElementById("toggleTheme");
          themeController?.setAttribute("value", newTheme);
          localStorage.setItem("theme", newTheme);
        }

        /* run before load page */
        const currentTheme = localStorage.getItem("theme") || DARK_THEME;
        const htmlTag = document.querySelector("html");
        const sun = document.getElementById("sun");
        const moon = document.getElementById("moon");
        htmlTag?.setAttribute("data-theme", currentTheme);
        if (currentTheme === LIGHT_THEME) {
          moon?.classList.add("swap-on");
          moon?.classList.remove("swap-off");
          sun?.classList.add("swap-off");
          sun?.classList.remove("swap-on");
        } else {
          moon?.classList.add("swap-off");
          moon?.classList.remove("swap-on");
          sun?.classList.add("swap-on");
          sun?.classList.remove("swap-off");
        }

        document
          ?.getElementById("toggleTheme")
          ?.addEventListener("click", toggleTheme);
      }
    </script>
    <script is:inline>
      const MAX_SCROLL = 768;
      function scrollToTop() {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      const button = document.getElementById("scrollToTop");
      if (button) {
        button.addEventListener("click", scrollToTop);
        if (window.scrollY > MAX_SCROLL) {
          button.style.display = "block";
        } else {
          button.style.display = "none";
        }
      }

      window.addEventListener("scroll", () => {
        const button = document.getElementById("scrollToTop");
        if (!button) return;
        if (window.scrollY > MAX_SCROLL) {
          button.style.display = "block";
        } else {
          button.style.display = "none";
        }
      });
    </script>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData, null, 2)}
    ></script>
    <GoogleAnalytics id="G-JPRTKK786T" />
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  body,
  html {
    font-family: "Nunito Sans Variable", sans-serif;
    scroll-behavior: smooth;
  }
</style>
